FROM python:3.12-slim

# ------------------------------------------------------------
# System packages
# ------------------------------------------------------------

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        git \
        build-essential \
    && rm -rf /var/lib/apt/lists/*


# ------------------------------------------------------------
# Non-root grading user
# ------------------------------------------------------------

RUN useradd \
        --create-home \
        --uid 10001 \
        grader


# ------------------------------------------------------------
# Working directory
# ------------------------------------------------------------

WORKDIR /grader


# ------------------------------------------------------------
# Python dependencies
# ------------------------------------------------------------

COPY requirements-grader.txt /grader/requirements-grader.txt

RUN pip install --no-cache-dir \
    -r /grader/requirements-grader.txt


# ------------------------------------------------------------
# Grading source
# ------------------------------------------------------------

COPY grade.py /grader/grade.py
COPY grading_worker.py /grader/grading_worker.py
COPY Labs_config.py /grader/Labs_config.py

COPY labs /grader/labs


# ------------------------------------------------------------
# Permissions
# ------------------------------------------------------------

RUN chown -R grader:grader /grader \
    && mkdir -p /home/grader/.ipython \
    && chown -R grader:grader /home/grader


USER grader


# ------------------------------------------------------------
# Worker entrypoint
# ------------------------------------------------------------

ENTRYPOINT ["python", "/grader/grading_worker.py"]